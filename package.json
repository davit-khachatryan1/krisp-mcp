{
  "name": "krisp-leads-mcp",
  "version": "1.0.0",
  "description": "MCP server that scores mock leads against Krisp's ICP and drafts first emails (drafts only, nothing is sent).",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
